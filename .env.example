POSTGRES_USER=agora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agora
# Server-side pepper for API-token hashes (HMAC-SHA256). Generate: openssl rand -hex 32
ARENA_TOKEN_PEPPER=change-me
# Image tag from ghcr.io/x-pai/alphagora-*: latest (main), sha-<short>, or a release tag like v1.0.0
AGORA_TAG=latest

# demo  = built-in synthetic market, loops one trading day every ~8 minutes (no data source needed)
# redis = live quotes from market-gateway (start with: docker compose --profile live up -d)
ARENA_MARKET_FEED=demo
# Sign-up: invite codes + seats per season (python -m arena_engine.admin invites create --kind human --count 20)
ARENA_REQUIRE_INVITE=1
ARENA_SEATS_HUMAN=100
ARENA_SEATS_AI=20
ARENA_DEMO_SPEED=30
# --- OpenPup 宏观辩论团 (optional; docker compose --profile pup up -d) ---
# 1) on the host: sudo ./deploy/fetch-openpup.sh v0.2.2      (installs the CLI release under /opt/openpup)
# 2) a shared token for the team; the engine and pup-team both read it. Generate: echo agk_$(openssl rand -hex 24)
PUP_TEAM_TOKEN=
# 3) the LLM the pups use (OpenAI-compatible chat API)
OPENPUP_API_KEY=
OPENPUP_API_BASE=
OPENPUP_MODEL=
PUP_TEAM_INTERVAL=300

# --- live mode only ---
# Arena universe: constituents of these CSI indices (downloaded from csindex.com.cn daily; last good list cached)
# 000300 CSI 300 · 000016 SSE 50 (inside CSI 300) · 000852 CSI 1000  ->  ~1,300 stocks
GATEWAY_INDICES=000300,000016,000905,000852
# Extra symbols on top of the indices (keep the benchmark ETF here)
GATEWAY_SYMBOLS=510300.SH,510050.SH,512100.SH
# Parallel TDX connections. 4 is plenty inside mainland China; a server abroad (higher latency to the TDX
# hosts) needs ~8 to keep 1,300 names under the 3s cycle (measured: avg 0.8s per worker on an AWS VM).
GATEWAY_CONNECTIONS=4
ARENA_DIVIDEND_SYMBOLS=601398.SH,600900.SH,601088.SH
TDX_SERVER=

# --- Alerts (engine + deploy/healthcheck.sh + deploy/backup.sh) ---
# Webhook URL; empty = log only. Test with: docker compose exec arena-engine python -m arena_engine.admin alert-test
ARENA_ALERT_WEBHOOK=
# generic (JSON {source,level,title,text,ts}) | wecom | feishu | dingtalk | slack
ARENA_ALERT_FORMAT=generic
