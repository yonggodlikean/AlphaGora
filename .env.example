POSTGRES_USER=agora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agora
# Server-side pepper for API-token hashes (HMAC-SHA256). Generate: openssl rand -hex 32
ARENA_TOKEN_PEPPER=change-me
# Where browsers reach the API (baked into the web build)
PUBLIC_API_URL=http://localhost:8000

# demo  = built-in synthetic market, loops one trading day every ~8 minutes (no data source needed)
# redis = live quotes from market-gateway (start with: docker compose --profile live up -d)
ARENA_MARKET_FEED=demo
ARENA_DEMO_SPEED=30
# --- OpenPup 宏观辩论团 (optional; docker compose --profile pup up -d) ---
# 1) on the host: sudo ./deploy/fetch-openpup.sh v0.2.2      (installs the CLI release under /opt/openpup)
# 2) a shared token for the team; the engine and pup-team both read it. Generate: echo agk_$(openssl rand -hex 24)
PUP_TEAM_TOKEN=
# 3) the LLM the pups use (OpenAI-compatible chat API)
OPENPUP_API_KEY=
OPENPUP_API_BASE=
OPENPUP_MODEL=
PUP_TEAM_INTERVAL=300

# --- live mode only ---
# Arena universe polled by the gateway (60 codes per TDX request). Include the benchmark ETF and dividend picks.
GATEWAY_SYMBOLS=510300.SH,601398.SH,600900.SH,601088.SH,600519.SH,600036.SH,000001.SZ,000858.SZ,300750.SZ,002594.SZ,688981.SH,601127.SH
ARENA_DIVIDEND_SYMBOLS=601398.SH,600900.SH,601088.SH
TDX_SERVER=
